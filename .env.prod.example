# 生产部署的环境变量。
#
# 用法：
#   cp .env.prod.example .env.prod
#   # 按下面的说明填写每一项
#   chmod 600 .env.prod        # 只有root能读
#
# ⚠️ `.env.prod` 里是真密钥，**绝不能提交到 git**。
# `.gitignore` 已经忽略了 `.env*`，但请自己确认一次：
#   git check-ignore -v .env.prod

# ================================================================
# 基础
# ================================================================

APP_NAME=MindFlow

# ⚠️ **必须是 production**。
#
# 它决定两件事：
# ① SECRET_KEY 是占位值时**拒绝启动**（见 app/main.py）；
# ② `check_secret_key` 的严格程度。
#
# 写成 development 会让占位密钥通过检查 —— 那等于关掉这道保护。
APP_ENV=production

# 对外访问的端口。绑 80 需要 root，或让 nginx/负载均衡转发。
HTTP_PORT=80

# ================================================================
# 数据库
# ================================================================

POSTGRES_DB=mindflow
POSTGRES_USER=mindflow

# ⚠️ **必须改成随机值**。开发用的 `mindflow_password` 是公开的，
# 用它等于没有密码。
#
# 生成：
#   openssl rand -base64 24
POSTGRES_PASSWORD=

# 下面两行会被 docker-compose.prod.yml 覆盖成容器内地址，
# 留空即可（保留是为了让这个文件能单独被工具读取）。
DATABASE_URL=
REDIS_URL=

# ================================================================
# Milvus 依赖的 MinIO
# ================================================================

# ⚠️ 同样要改。开发默认的 minioadmin/minioadmin 是公开凭据。
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=

# ================================================================
# JWT
# ================================================================

# ⚠️ **必须换成一个真随机值**，不能用 `.env` 里那个。
#
# 生成：
#   uv run python -m app.core.generate_secret
# 或：
#   openssl rand -base64 48
#
# 为什么必须换：占位密钥最危险的地方是它**能正常工作** ——
# 本地测试、部署全都不报错，直到有人用它伪造出合法的登录令牌。
SECRET_KEY=

ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ================================================================
# 注册控制（成本控制的关键）
# ================================================================

# ⚠️ **必须为 true**（对任何对外可访问的部署）。
#
# 为什么：注册开放意味着任何陌生人都能给自己开一个带
# 「10 场面试 + 100 题」额度的账号，而每一道题都真实调用
# **你的** LLM 与嵌入 API —— 也就是真实花你的钱。
#
# 限流管的是"单个人用多少"，管不了"多少人可以用"。
#
# 开启后，新用户注册必须提供邀请码。发码方式：
#   docker compose -f docker-compose.prod.yml exec backend \
#     uv run python -m app.core.manage_invites create \
#     --count 5 --note "内测朋友" --expires-days 14
REGISTRATION_REQUIRE_INVITE=true

# ================================================================
# 模型端点
# ================================================================

# 对话模型
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=

# 嵌入模型
#
# ⚠️ 换模型会使已入库向量失效，必须重建索引 ——
# 见 MIND_FLOW_PLAN.md §21 维护规则。
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=

# ================================================================
# 额度（控制成本的第二道闸）
# ================================================================

# 单账号每月能开几场面试、问几道题。
#
# 调小这两个数字是**最直接的降本手段** ——
# 即使邀请码泄露，损失上限也是：
#   码数 × 每月额度
#
# 建议体验期用比默认值更小的数（例如 3 场 / 30 题）。
# 不填则用代码默认（10 场 / 100 题）。
# INTERVIEW_QUOTA=3
# MONTHLY_QUESTION_QUOTA=30

# ================================================================
# 上传限制
# ================================================================

# 与 nginx 的 `client_max_body_size 8m` 配合：
# 后端上限 5 MB，nginx 放宽到 8 MB 以容纳 multipart 开销。
MAX_UPLOAD_BYTES=5242880
MAX_DOCUMENT_CHARS=250000
MAX_CHUNKS_PER_DOCUMENT=500

# ================================================================
# 限流
# ================================================================

RATE_LIMIT_ENABLED=true
# 注册频率：即使有邀请码，也限制单位时间内的注册尝试。
RATE_LIMIT_REGISTER_TIMES=5
RATE_LIMIT_REGISTER_SECONDS=3600
# 登录：防暴力破解
RATE_LIMIT_LOGIN_TIMES=20
RATE_LIMIT_LOGIN_SECONDS=3600
# 上传：按用户（直接花钱的路径）
RATE_LIMIT_UPLOAD_TIMES=30
RATE_LIMIT_UPLOAD_SECONDS=3600
# 开始面试：按用户
RATE_LIMIT_START_INTERVIEW_TIMES=10
RATE_LIMIT_START_INTERVIEW_SECONDS=3600

# ================================================================
# 其他
# ================================================================

# CORS：同域部署（nginx 反代 /api）时**留空即可**。
# 只有前后端不同源时才需要，例如：
#   CORS_ALLOW_ORIGINS=https://mindflow.example.com
CORS_ALLOW_ORIGINS=

# 进度回调、状态机等内部重试
ONLINE_EVALUATION_SAMPLES=1
OFFLINE_EVALUATION_SAMPLES=3

# 索引 worker：单实例部署时保持 true（进程内跑）。
# 多副本部署时必须设为 false 并另外起一个 worker 容器。
WORKER_ENABLED=true
