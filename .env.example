APP_NAME=MindFlow AI
APP_ENV=development

DATABASE_URL=
REDIS_URL=

# =====================
# 大模型（面试引擎与评估使用）
# =====================
# 需要 OpenAI 兼容的 /chat/completions 端点。
# 当前使用 Agnes AI（模型 agnes-3.0-flash）。
#
# 换端点时必须重跑 `app/evaluation/interview/cli.py` 并保存报告 ——
# 报告里记录了 model 与 base_url，换了模型后的分数**不可与旧报告比较**
# （见 MIND_FLOW_PLAN.md §8A.8 与 ADR-021）。
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=

# =====================
# Embedding
# =====================
# 与 LLM 分开配置：更换 Embedding 模型会使已入库向量失效，
# 必须重建索引（见 §21 维护规则）。
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=

# =====================
# JWT
# =====================
# ⚠️ **不要随手敲一串。** 用下面这条生成密码学安全的随机值：
#
#     uv run python -m scripts.generate_secret
#
# 为什么强调这一点：本项目实测长期使用过
# `mindflow_2026_development_secret_key_change_later` ——
# 它**看起来像配置**（有年份、有项目名、格式正常），实际是占位符。
# 这种值最危险的地方是**它能正常工作**：开发、测试、部署全都不报错，
# 直到有人用它伪造出合法的登录令牌。
#
# 因此后端启动时会校验它（`app/main.py` 的 `_check_secret_key`）：
# **`APP_ENV` 不是 development 时用占位值会拒绝启动。**
#
# 换密钥会让所有已签发的令牌立即失效（所有用户需重新登录）。
SECRET_KEY=
ALGORITHM=HS256

# =====================
# CORS
# =====================
# 允许的跨域来源，逗号分隔。**默认留空 = 不启用 CORS**，
# 这对本项目是**正确**的：前端把 `/api` 代理到后端
# （见 `web/vite.config.ts`），浏览器看到的是同源请求。
#
# 只有前后端**不同源**部署时才需要，例如：
#     CORS_ALLOW_ORIGINS=https://mindflow.example.com
#
# ⚠️ 不要填 `*`。配合 `allow_credentials=True`，
# 那会让任意网站都能带着用户凭据调这个 API ——
# 而它在本地完全看不出问题（因为本地本来就同源）。
CORS_ALLOW_ORIGINS=

# =====================
# 上传体积上限（可选，有合理默认值）
# =====================
# D67 的四条防线：一个超大文件会切出成千上万块，
# 而每块都是一次**按量计费**的嵌入调用。
#
# 上限依据见 `uv run python -m scripts.measure_document_sizes`。
# MAX_UPLOAD_BYTES=5242880
# MAX_DOCUMENT_CHARS=250000
# MAX_CHUNKS_PER_DOCUMENT=500
