APP_NAME=MindFlow AI
APP_ENV=development

DATABASE_URL=
REDIS_URL=

# =====================
# 大模型（面试引擎与评估使用）
# =====================
# 需要 OpenAI 兼容的 /chat/completions 端点。
# 当前使用 Agnes AI（模型 agnes-3.0-flash）。
#
# 换端点时必须重跑 `app/evaluation/interview/cli.py` 并保存报告 ——
# 报告里记录了 model 与 base_url，换了模型后的分数**不可与旧报告比较**
# （见 MIND_FLOW_PLAN.md §8A.8 与 ADR-021）。
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=

# =====================
# Embedding
# =====================
# 与 LLM 分开配置：更换 Embedding 模型会使已入库向量失效，
# 必须重建索引（见 §21 维护规则）。
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=

# =====================
# JWT
# =====================
SECRET_KEY=
ALGORITHM=HS256
